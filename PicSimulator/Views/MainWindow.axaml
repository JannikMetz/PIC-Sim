<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PicSimulator.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="PicSimulator.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Icon.ico"
        Title="PicSimulator"
        Background="#3c3f41">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>
    <Grid>
        <!-- Definiere die Zeilen und Spalten des Grids -->
        <Grid.RowDefinitions>
            <RowDefinition Height="0.4*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Navigationsleiste -->
        <Menu Grid.Row="0" Grid.ColumnSpan="3" Background="#1b1b1b" >
            <MenuItem Header="Datei">
                <MenuItem Header="Laden" Command="{Binding LoadCommand}"/>
                <Separator/>
                <MenuItem Header="Speichern" Command="{Binding SaveCommand}"/>
                <MenuItem Header="Speichern unter" Command="{Binding SaveAsCommand}"/>
            </MenuItem>
            <MenuItem Header="Einstellungen">
            </MenuItem>
        </Menu>
        <Border Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10" Margin="10,10,10,10" ClipToBounds="True">
        
        <ScrollViewer  Background="#1b1b1b"></ScrollViewer>
        </Border>
            <Border Grid.Row="2" Grid.Column="1" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10" Margin="0,10,10,10" ClipToBounds="True">
        <ScrollViewer  Background="#1b1b1b">
            <TextBlock Text="{Binding FileContent}" TextWrapping="Wrap" />
        </ScrollViewer>
        </Border>
    </Grid>
</Window>
